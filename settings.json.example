{
  "attribution": false,
  "permissions": {
    "deny": [
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(composer.lock)",
      "Edit(package-lock.json)",
      "Edit(yarn.lock)",
      "Edit(pnpm-lock.yaml)"
    ],
    "ask": [
      "Bash(*artisan migrate:fresh*)",
      "Bash(*artisan migrate:reset*)",
      "Bash(*artisan db:wipe*)",
      "Bash(*manage.py flush*)",
      "Bash(*manage.py reset_db*)",
      "Bash(*db:drop*)",
      "Bash(*db:reset*)",
      "Bash(*db:schema:load*)",
      "Bash(*db:purge*)",
      "Bash(git push*--force*)",
      "Bash(git push* -f*)",
      "Bash(git reset*--hard*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/workflow-state.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/verify-tasks-complete.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify-user.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0
  }
}
